// Configuração do Worker "reunioes" (Cloudflare Workers ligado ao GitHub).
// O servidor (site/_worker.js) corre primeiro em TODOS os pedidos e só depois entrega os ficheiros da app.
{
  "name": "reunioes",
  "main": "site/_worker.js",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Mantém as variáveis e segredos definidos no painel do Cloudflare em cada publicação.
  "keep_vars": true,
  // Registos persistentes (Workers Logs): permitem ver os erros de diagnóstico do login no painel.
  "observability": { "enabled": true },
  // Armazenamento: lista de utilizadores, anti-duplicação e auditoria (namespace "fercopor-reunioes").
  "kv_namespaces": [{ "binding": "REUNIOES_KV", "id": "3f79433b0c0641109f4fb95da8e40735" }],
  // Login: só «Iniciar sessão com Microsoft» (Entra ID). O Cloudflare Access deixa de ser aceite.
  // MICROSOFT_TENANT_ID, MICROSOFT_CLIENT_ID, MICROSOFT_CLIENT_SECRET e ADMIN_EMAILS ficam no painel (keep_vars).
  "vars": {
    "AUTH_MODE": "entra"
  }
}
